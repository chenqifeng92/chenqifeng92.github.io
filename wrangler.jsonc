{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cv",
  "main": "worker.js",
  "compatibility_date": "2026-07-17",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "FEEDBACK_DB",
      "database_name": "cv-feedback",
      "database_id": "f7717cc1-8058-46b9-acaa-c99078b5c950"
    }
  ]
}
